<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imageProd"
            android:layout_width="125dp"
            android:layout_height="125dp"
            android:layout_marginRight="10dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/poref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="REF: " />

            <TextView
                android:id="@+id/posize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/poref"
                android:layout_marginBottom="3dp"
                android:text="Size: " />

            <TextView
                android:id="@+id/pocolor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/posize"
                android:layout_marginBottom="3dp"
                android:text="Color: " />

            <TextView
                android:id="@+id/deliverby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pocolor"
                android:layout_marginBottom="3dp"
                android:text="Deliver by: " />

            <Button
                android:id="@+id/cancelOrder"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:layout_below="@+id/deliverby"
                android:backgroundTint="@color/red"
                android:text="Cancel Order"
                android:textColor="@color/white"
                android:textSize="12dp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gray"
            android:textSize="15dp"
            android:textStyle="bold"
            android:text="Shipping"
            android:padding="10dp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/shippingaddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Address: "
            android:textStyle="bold"
            android:padding="10dp"
            />

        <TextView
            android:id="@+id/customer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: "
            android:textStyle="bold"
            android:padding="10dp"
            />

        <TextView
            android:id="@+id/shipby"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ship by: "
            android:textStyle="bold"
            android:padding="10dp"
            />

    </LinearLayout>

</LinearLayout>