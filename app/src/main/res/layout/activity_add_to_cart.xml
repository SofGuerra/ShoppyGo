<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="30dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/addimageProd"
            android:layout_width="170dp"
            android:layout_height="200dp"
            android:layout_marginRight="10dp" />


    </LinearLayout>


    <TextView
        android:id="@+id/addproductName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="5dp"
        android:hint="Product Name"
        android:inputType="text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/addproductPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="5dp"
        android:hint="$99.99"
        android:inputType="numberDecimal"
        android:textSize="25dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="5dp"
        android:text="Available Colors: "
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/addcolorWhite"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

        <ImageView
            android:id="@+id/addcolorBlack"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

        <ImageView
            android:id="@+id/addcolorBrown"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

        <ImageView
            android:id="@+id/addcolorGreen"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

        <ImageView
            android:id="@+id/addcolorGray"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

        <ImageView
            android:id="@+id/addcolorBeige"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_margin="6dp"
            android:background="@drawable/color_square" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="5dp"
        android:text="Sizes: "
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addxs"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:layout_marginLeft="5dp"
            android:backgroundTint="@color/gray"
            android:text="XS" />

        <Button
            android:id="@+id/adds"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:layout_marginLeft="5dp"
            android:backgroundTint="@color/gray"
            android:text="S" />

        <Button
            android:id="@+id/addm"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:layout_marginLeft="5dp"
            android:backgroundTint="@color/gray"
            android:text="M" />

        <Button
            android:id="@+id/addl"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:layout_marginLeft="5dp"
            android:backgroundTint="@color/gray"
            android:text="L" />

        <Button
            android:id="@+id/addxl"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:layout_marginLeft="5dp"
            android:backgroundTint="@color/gray"
            android:text="XL" />

    </LinearLayout>

    <Button
        android:id="@+id/addbtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/green"
        android:text="Add To Cart" />

</LinearLayout>